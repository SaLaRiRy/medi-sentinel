# LLM / embeddings — copy to `.env` and fill in (the real file is gitignored).
# All values are read through `core.config.Settings` (field name == env name);
# blank means "use the code default", and a blank key or base URL keeps the
# unavailable port, so `/chat/send` ends with a 503 `error` frame.

# OpenAI-compatible API key (DashScope/百炼). Blank by default.
OPENAI_API_KEY=

# OpenAI-compatible base URL. Blank in code falls back to the generic endpoint;
# set your private/deployment endpoint here instead of hardcoding it.
OPENAI_BASE_URL=

# Chat model used for generation. Blank falls back to the code default.
LLM_MODEL=

# Embedding model used by the vector store. Blank falls back to the code default.
EMBEDDING_MODEL=
