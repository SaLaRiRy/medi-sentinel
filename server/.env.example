# 配置样例 —— 复制成 `.env` 再填写（真实 `.env` 已被 gitignore）。
# 所有值经 `core.config.Settings` 读取：字段名 == 环境变量名（大小写不敏感）。
# 留空表示「未提供」——回退到代码默认值（`env_ignore_empty=True`）；需要凭据的
# 字段（DATABASE_URL / NEO4J_PASSWORD / JWT_SECRET_KEY / OPENAI_API_KEY）留空
# 即视为缺失。

# 关系库连接串（必填）。留空时后端启动即报错，不会退回旧的硬编码默认。
# 形如：mysql+aiomysql://<user>:<password>@127.0.0.1:3306/medi_sentinel
DATABASE_URL=

# Neo4j 图库连接（口令建议填写；端点与用户名留空则用代码默认）。
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# 令牌签名密钥（建议填写；留空不报错，但签名强度为零，正式环境务必设置）。
JWT_SECRET_KEY=

# OpenAI 兼容 API key（DashScope/百炼）。留空则 /chat/send 以 503 `error` 帧结束。
OPENAI_API_KEY=

# OpenAI 兼容 base URL。留空回退到代码默认端点；私有/部署端点写这里。
OPENAI_BASE_URL=

# 生成模型。留空回退到代码默认。
LLM_MODEL=

# 向量库嵌入模型。留空回退到代码默认。
EMBEDDING_MODEL=
